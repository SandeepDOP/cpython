import tkinter as tk
from tkinter import ttk

class PhotographyFrameApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Photography Scene Framing")

        # Scene Selection
        self.scene_label = ttk.Label(root, text="Select Scene:")
        self.scene_label.grid(row=0, column=0, padx=10, pady=10)

        self.scene_var = tk.StringVar()
        self.scene_combobox = ttk.Combobox(root, textvariable=self.scene_var, state="readonly")
        self.scene_combobox['values'] = ("Portrait", "Landscape", "Night", "Macro")
        self.scene_combobox.current(0)
        self.scene_combobox.grid(row=0, column=1, padx=10, pady=10)
        self.scene_combobox.bind("<<ComboboxSelected>>", self.update_frame)

        # Canvas for Frame Display
        self.canvas = tk.Canvas(root, width=400, height=300, bg="white")
        self.canvas.grid(row=1, column=0, columnspan=2, padx=10, pady=10)

        # Initial Frame
        self.update_frame()

    def update_frame(self, event=None):
        scene = self.scene_var.get()
        self.canvas.delete("all")  # Clear previous frame

        if scene == "Portrait":
            self.draw_portrait_frame()
        elif scene == "Landscape":
            self.draw_landscape_frame()
        elif scene == "Night":
            self.draw_night_frame()
        elif scene == "Macro":
            self.draw_macro_frame()

    def draw_portrait_frame(self):
        # Draw guidelines for portrait photography
        self.canvas.create_rectangle(100, 50, 300, 250, outline="blue", width=2)  # Main frame
        self.canvas.create_line(200, 50, 200, 250, fill="blue", width=2)  # Vertical center line
        self.canvas.create_line(100, 150, 300, 150, fill="blue", width=2)  # Horizontal center line
        self.canvas.create_text(200, 270, text="Portrait: Focus on the subject's eyes", fill="black")

    def draw_landscape_frame(self):
        # Draw guidelines for landscape photography
        self.canvas.create_rectangle(50, 100, 350, 200, outline="green", width=2)  # Main frame
        self.canvas.create_line(200, 100, 200, 200, fill="green", width=2)  # Vertical center line
        self.canvas.create_line(50, 150, 350, 150, fill="green", width=2)  # Horizontal center line
        self.canvas.create_text(200, 220, text="Landscape: Use the rule of thirds", fill="black")

    def draw_night_frame(self):
        # Draw guidelines for night photography
        self.canvas.create_rectangle(50, 50, 350, 250, outline="yellow", width=2)  # Main frame
        self.canvas.create_line(200, 50, 200, 250, fill="yellow", width=2)  # Vertical center line
        self.canvas.create_line(50, 150, 350, 150, fill="yellow", width=2)  # Horizontal center line
        self.canvas.create_text(200, 270, text="Night: Use a tripod and long exposure", fill="black")

    def draw_macro_frame(self):
        # Draw guidelines for macro photography
        self.canvas.create_oval(150, 100, 250, 200, outline="red", width=2)  # Circular frame
        self.canvas.create_text(200, 220, text="Macro: Focus on small details", fill="black")

if __name__ == "__main__":
    root = tk.Tk()
    app = PhotographyFrameApp(root)
    root.mainloop()
